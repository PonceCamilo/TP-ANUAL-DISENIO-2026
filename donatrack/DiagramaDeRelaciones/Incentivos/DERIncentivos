Table mision {
  id_mision int [pk]
  id_categoria int [not null]
  id_insignia int [not null]
  nombre varchar(100) [not null]
  descripcion text
}

Table categoria_donante {
  id_categoria int [pk]
  nombre varchar(50) [not null]
  orden int [not null]
}

Table insignia {
  id_insignia int [pk]
  nombre varchar(100) [not null]
  imagen varchar(255)
}

Table insignia_obtenida {
  id_insignia_obtenida int [pk]
  id_donante uuid [not null]
  id_insignia int [not null]
  visibilidad boolean
  fecha_obtencion date [not null]
}

Table donante {
  id_donante uuid [pk]
  id_categoria int [not null]
  created_at timestamp
}

Table progreso_mision {
  id_progreso int [pk]
  id_donante uuid [not null]
  id_mision int [not null]
  esta_completada boolean
  actualizado_al timestamp
}

Table donacion_registrada {
  id_donacion uuid [pk]
  id_donante uuid [not null]
  id_entidad_beneficiaria uuid [not null]
  fecha datetime [not null]
  cantidad_bienes int
  exitosa boolean
}

Table donacion_categoria {
  id_donacion uuid [not null]
  categoria varchar(50) [not null]

  indexes {
    (id_donacion, categoria) [pk]
  }
}

Table posicion_ranking {
  id_posicion int [pk]
  id_ranking int [not null]
  id_donante uuid [not null]
  puesto int [not null]
  misiones_completadas int
  periodo_inicio datetime [not null]
}

Table ranking_mensual {
  id_ranking int [pk]
  periodo_inicio datetime [not null]
  fecha_calculo datetime [not null]
}

Table HabilDonador {
  id_habil_donador int [pk]
  id_mision int [not null]
  cant_bienes_requerida int [not null]
}

Table Completitud {
  id_completitud int [pk]
  id_mision int [not null]
  cant_categorias_requeridas int [not null]
}

Table DonacionesExitosas {
  id_donaciones_exitosas int [pk]
  id_mision int [not null]
  cant_donaciones_requeridas int [not null]
}

Table Racha {
  id_racha int [pk]
  id_mision int [not null]
  cant_meses_requeridos int [not null]
}

Ref: mision.id_categoria > categoria_donante.id_categoria
Ref: mision.id_insignia > insignia.id_insignia
Ref: insignia_obtenida.id_donante > donante.id_donante
Ref: insignia_obtenida.id_insignia > insignia.id_insignia
Ref: donante.id_categoria > categoria_donante.id_categoria
Ref: progreso_mision.id_donante > donante.id_donante
Ref: progreso_mision.id_mision > mision.id_mision
Ref: donacion_registrada.id_donante > donante.id_donante
Ref: donacion_categoria.id_donacion > donacion_registrada.id_donacion
Ref: posicion_ranking.id_ranking > ranking_mensual.id_ranking
Ref: posicion_ranking.id_donante > donante.id_donante
Ref: HabilDonador.id_mision - mision.id_mision
Ref: Completitud.id_mision - mision.id_mision
Ref: DonacionesExitosas.id_mision - mision.id_mision
Ref: Racha.id_mision - mision.id_mision

