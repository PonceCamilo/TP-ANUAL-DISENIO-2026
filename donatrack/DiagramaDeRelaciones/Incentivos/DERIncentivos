Table categoria_donante {
  tipo_categoria varchar(31) [not null]
  orden int [pk]
  nombre varchar(255)
}

Table insignia {
  id bigint [pk, increment]
  nombre varchar(255)
  imagen varchar(255)
}

Table mision {
  id bigint [pk, increment]
  nombre varchar(255)
  descripcion varchar(255)
  objetivo int [not null]
  orden int [not null]
  categoria_requerida_orden int
  insignia_id bigint [unique]
}

Table habil_donador {
  id bigint [pk]
  cantidad_bienes_requerida int [not null]
}

Table completitud {
  id bigint [pk]
  categorias_requeridas int [not null]
}

Table donaciones_exitosas {
  id bigint [pk]
  cantidad_donaciones_requerida int [not null]
}

Table racha {
  id bigint [pk]
  meses_requeridos int [not null]
}

Table donante {
  id uuid [pk]
  categoria_actual_orden int
  mision_actual_id bigint
}

Table insignia_obtenida {
  id bigint [pk, increment]
  insignia_id bigint
  visibilidad boolean [not null]
  fecha_obtencion date
}

Table donacion_registrada {
  id uuid [pk]
  fecha timestamp
  cantidad_bienes int [not null]
  exitosa boolean [not null]
  entidad_beneficiaria varchar(255)
}

Table donacion_categoria {
  donacion_id uuid [not null]
  categorias varchar(255)
}

Table donante_insignias_obtenidas {
  donante_id uuid [not null]
  insignias_obtenidas_id bigint [not null, unique]
}

Table donante_donaciones {
  donante_id uuid [not null]
  donaciones_id uuid [not null, unique]
}

Table ranking_mensual {
  id bigint [pk, increment]
  periodo_inicio timestamp
  fecha_calculo timestamp
}

Table posicion_ranking {
  id bigint [pk, increment]
  donante_id uuid
  puesto int [not null]
  misiones_completadas int [not null]
  dia_de_creacion timestamp
}

Table ranking_mensual_posiciones {
  ranking_mensual_id bigint [not null]
  posiciones_id bigint [not null, unique]
}

Ref: mision.categoria_requerida_orden > categoria_donante.orden
Ref: mision.insignia_id - insignia.id

Ref: habil_donador.id - mision.id
Ref: completitud.id - mision.id
Ref: donaciones_exitosas.id - mision.id
Ref: racha.id - mision.id

Ref: donante.categoria_actual_orden > categoria_donante.orden
Ref: donante.mision_actual_id > mision.id

Ref: insignia_obtenida.insignia_id > insignia.id

Ref: donacion_categoria.donacion_id > donacion_registrada.id

Ref: donante_insignias_obtenidas.donante_id > donante.id
Ref: donante_insignias_obtenidas.insignias_obtenidas_id > insignia_obtenida.id

Ref: donante_donaciones.donante_id > donante.id
Ref: donante_donaciones.donaciones_id > donacion_registrada.id

Ref: posicion_ranking.donante_id > donante.id
Ref: ranking_mensual_posiciones.ranking_mensual_id > ranking_mensual.id
Ref: ranking_mensual_posiciones.posiciones_id > posicion_ranking.id
