    "name": "DonaTrack - Servicio de Incentivos",
    "description": "Coleccion de endpoints principales del servicio de incentivos. Importar en Postman y ejecutar con el servicio levantado en el puerto 8083.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Procesar donacion registrada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"donanteId\": \"{{donanteId}}\",\n  \"destinatario\": \"{{destinatario}}\",\n  \"medio\": \"EMAIL\",\n  \"cantidadBienes\": 12,\n  \"categoriasDonadas\": [\n    \"ALIMENTOS\",\n    \"ABRIGO\"\n  ],\n  \"fecha\": \"2026-06-24T19:07:54\",\n  \"entidadBeneficiaria\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/incentivos/donantes/donacion",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "incentivos",
            "donantes",
            "donacion"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Respuesta no vacia\", function () {",
              "  pm.expect(pm.response.text()).to.not.be.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
