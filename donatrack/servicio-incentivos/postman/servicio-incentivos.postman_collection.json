        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Incluye datos principales\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property(\"donanteId\");",
              "  pm.expect(json).to.have.property(\"categoriaActual\");",
              "  pm.expect(json).to.have.property(\"totalDonacionesHistoricas\");",
              "  pm.expect(json).to.have.property(\"donacionesMesActual\");",
              "  pm.expect(json).to.have.property(\"organizacionesAyudadas\");",
              "  pm.expect(json).to.have.property(\"posicionRanking\");",
              "});"
            ]
          }
        }
      ]
    },
