@startuml diagramaClasesLogisticaModel

skinparam classAttributeIconSize 0

' Bounded context Logística: las entidades de Donaciones no se modelan acá.
' Se referencian solo por identificadores primitivos (UUID).

class Direccion {
    - calle : String
    - numero : int
    - localidad : String
    - provincia : String
    - codigoPostal : String
}

class Camion {
    - patente : String
    - capacidadVolumenM3 : double
    - alturaM : double
    - capacidadCargaKg : double
    - estado : EstadoCamion
}

enum EstadoCamion {
    DISPONIBLE
    EN_RUTA
    MANTENIMIENTO
}

class LotePlanificacion {
    - camiones : List<Camion>
    - donaciones : List<DonacionLote>
    - estado : EstadoLote
    - tokenCorrelacion : String
    - fechaEnvio : LocalDateTime
    - fechaRespuesta : LocalDateTime
}

enum EstadoLote {
    ENVIADO
    EN_PROCESO
    COMPLETADO
    ERROR
}

class DonacionLote {
    - idDonacion : UUID
    - idEntidadBeneficiaria : UUID
    - direccionEntrega : Direccion
}

class Ruta {
    - lote : LotePlanificacion
    - camion : Camion
    - paradas : List<Parada>
    - estado : EstadoRuta
    - fechaInicio : LocalDateTime
    + obtenerEntregas() : List<Entrega>
    + buscarParadaPorEntregaId(entregaId : UUID) : Optional<Parada>
}

enum EstadoRuta {
    PLANIFICADA
    INICIADA
    FINALIZADA
}

class Parada {
    - orden : int
    - direccion : Direccion
    - idEntidadBeneficiaria : UUID
    - entregas : List<Entrega>
}

class Entrega {
    - parada : Parada
    - idDonacion : UUID
    - estado : EstadoEntrega
    - historial : List<CambioEstadoEntrega>
    - fotosComprobante : List<String>
    - observacion : String
    - fechaEntrega : LocalDateTime
    + registrarCambio(nuevoEstado : EstadoEntrega, observacion : String) : void
}

enum EstadoEntrega {
    PENDIENTE
    EN_TRASLADO
    ENTREGADA
    NO_RECIBIDA
}

class CambioEstadoEntrega {
    - estado : EstadoEntrega
    - observacion : String
    - fechaHora : LocalDateTime
}


Camion -- EstadoCamion

Entrega -- EstadoEntrega
Entrega --> "*" CambioEstadoEntrega

CambioEstadoEntrega -- EstadoEntrega

Parada --> Direccion
Parada "1" --> "*" Entrega
Entrega --> Parada

Ruta -- EstadoRuta
Ruta --> Camion
Ruta --> "*" Parada
Ruta --> LotePlanificacion

LotePlanificacion -- EstadoLote
LotePlanificacion --> "*" Camion
LotePlanificacion --> "*" DonacionLote

DonacionLote --> Direccion

@enduml
