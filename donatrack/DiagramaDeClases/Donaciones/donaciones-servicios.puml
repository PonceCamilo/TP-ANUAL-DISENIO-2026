    }
}

package integracion.notificaciones {

    class NotificacionTransportRest {
        private restClient: RestClient

        public enviar(solicitud: SolicitudNotificacionMensaje): void
        public nombre(): String
    }

    class NotificacionTransportAmqp {
        private rabbitTemplate: RabbitTemplate

        public enviar(solicitud: SolicitudNotificacionMensaje): void
        public nombre(): String
    }

    class SolicitudNotificacionMensaje <<record>> {
        destinatario: String
        mensaje: String
        medio: String
    }

    note as NotaTransporte
        Se crea una sola implementación según
        la property notificaciones.transporte:
        rest (predeterminado) → POST /notificaciones (8084)
        amqp → exchange donatrack.notificaciones,
        routing key notificacion.enviar
        (RabbitMQConfig solo se carga con amqp)
    end note
}

package config {

    class RabbitMQConfig {
        {static} public EXCHANGE: String = "donatrack.notificaciones"
        {static} public ROUTING_KEY: String = "notificacion.enviar"
        {static} public QUEUE: String = "notificaciones.queue"

        public notificacionesExchange(): TopicExchange
        public notificacionesQueue(): Queue
        public notificacionesBinding(notificacionesQueue: Queue, notificacionesExchange: TopicExchange): Binding
        public jsonMessageConverter(): MessageConverter
        public rabbitTemplate(connectionFactory: ConnectionFactory, jsonMessageConverter: MessageConverter): RabbitTemplate
    }
}

