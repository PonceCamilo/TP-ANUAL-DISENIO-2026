    note as NotaDependencias
        Las dependencias de cada service hacia las interfaces de
        interfaces.repositories figuran como atributos tipados y no se
        dibujan como flechas, para no saturar el diagrama.
        Los métodos «@Scheduled» indican la expresión cron del proceso
        nocturno; todos usan la zona America/Argentina/Buenos_Aires
        (FechaHoraArgentina.ZONA_ID), no la del servidor.
    end note

    abstract class AlgoritmoAsignacionBase <<abstracta>> {
        {static} protected TOP_N: int = 10

        public final evaluar(donacion: Donacion, entidades: List<EntidadBeneficiaria>): List<ResultadoAsignacion>
        protected prepararPuntaje(donacion: Donacion, entidades: List<EntidadBeneficiaria>): ToDoubleFunction<EntidadBeneficiaria>
        {abstract} protected calcularPuntaje(donacion: Donacion, entidad: EntidadBeneficiaria): double
        protected incluir(puntaje: double): boolean
    }

    class AlgoritmoCompatibilidadSemantica {
        protected calcularPuntaje(donacion: Donacion, entidad: EntidadBeneficiaria): double
        protected incluir(puntaje: double): boolean
    }

    class AlgoritmoPrioridadSubAtendidos {
        {static} private MESES_TRIMESTRE: int = 3
        private recepciones: RecepcionesEntidadRepositoryInterface

        protected prepararPuntaje(donacion: Donacion, entidades: List<EntidadBeneficiaria>): ToDoubleFunction<EntidadBeneficiaria>
        protected calcularPuntaje(donacion: Donacion, entidad: EntidadBeneficiaria): double
        {static} private inicioDelTrimestre(): LocalDate
        {static} private puntaje(donacionesRecibidas: long): double
    }

    note as NotaAlgoritmos
        Template method: evaluar() llama una vez a
        prepararPuntaje() por ranking. SubAtendidos lo
        redefine para leer en UNA consulta las recepciones
        del trimestre de todas las entidades
        (tabla entidad_recepcion_diaria, Entrega 5).
    end note
}

