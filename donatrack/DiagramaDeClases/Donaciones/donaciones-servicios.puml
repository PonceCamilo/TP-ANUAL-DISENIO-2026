package util {

    class "Pagina<T>" as Pagina <<record>> {
        contenido: List<T>
        numero: int
        tamanio: int
        totalElementos: long

        public totalPaginas(): int
        public map(transformacion: Function<T, R>): Pagina<R>
    }

    class SolicitudPagina <<record>> {
        {static} public TAMANIO_POR_DEFECTO: int = 20
        {static} public TAMANIO_MAXIMO: int = 100
        numero: int
        tamanio: int

        {static} public de(numero: Integer, tamanio: Integer): SolicitudPagina
    }

    class NormalizadorEmail {
        {static} public normalizar(email: String): String
    }

    class FechaHoraArgentina {
        {static} public ZONA_ID: String = "America/Argentina/Buenos_Aires"
        {static} public ZONA: ZoneId

        {static} public ahora(): LocalDateTime
        {static} public hoy(): LocalDate
    }

    note as NotaUtil
        SolicitudPagina valida en su constructor page >= 0 y
        1 <= size <= 100 (de(): sin valor, 0 y 20);
        si no, PaginaInvalidaException → 400.
        NormalizadorEmail: trim + NFC + minúsculas (Locale.ROOT).
        Es la forma con la que se guarda y se busca el email; lo usan
        PersonasValidator, PersonaDonanteRepository y CsvImportService.
        Los services de donaciones y donantes devuelven
        PaginaResponseDTO.desde(Pagina) en los listados.
    end note
}

