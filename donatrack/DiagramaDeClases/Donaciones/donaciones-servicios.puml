        private recepciones: RepositorioRecepcionesEntidad

        public reconciliar(): void «@Scheduled 0 0 3 * * *, @SchedulerLock, @Transactional»
    }

    class PlanificacionEntregasService {
        private donacionesRepositorio: RepositorioDonaciones
        private entidadesRepositorio: RepositorioEntidadesBeneficiarias
        private brokerClient: BrokerLogisticaClient
        private propiedades: DonacionesProperties
        private transaccion: TransactionOperations

        public despachar(idsDonaciones: List<UUID>, proveedor: ProveedorLogistica): EnvioLogisticaResponseDTO
        public despacharPendientesDelDia(): void «@Scheduled 0 0 4 * * *, @SchedulerLock»
    }

    note as NotaProcesos
        Los procesos nocturnos recorren las donaciones de a
        lotes de 100 ordenados por id (obtenerLoteEnEstado),
        cada uno en una transacción corta. El despacho manda
        cada lote al broker por separado y deja la llamada
        fuera de la transacción. El matchmaking reemplaza la
        bandeja al final y en esa misma transacción descarta
        las donaciones que dejaron el depósito mientras
        corría. El aviso de inactividad también confirma
        cada lote de 100 personas por separado.
        Todos los cron usan la zona America/Argentina/Buenos_Aires
        (FechaHoraArgentina.ZONA_ID), no la del servidor.
    end note

    abstract class AlgoritmoAsignacionBase <<abstracta>> {
        public final evaluar(donacion: Donacion, entidades: List<EntidadBeneficiaria>, tamanio: int): List<ResultadoAsignacion>
        protected prepararPuntaje(donacion: Donacion, entidades: List<EntidadBeneficiaria>): ToDoubleFunction<EntidadBeneficiaria>
        {abstract} protected calcularPuntaje(donacion: Donacion, entidad: EntidadBeneficiaria): double
        protected incluir(puntaje: double): boolean
    }

    class AlgoritmoCompatibilidadSemantica {
        {static} public NOMBRE: String = "COMPATIBILIDAD_SEMANTICA"

        public nombre(): String
        protected calcularPuntaje(donacion: Donacion, entidad: EntidadBeneficiaria): double
        protected incluir(puntaje: double): boolean
    }

    class AlgoritmoPrioridadSubAtendidos {
        {static} public NOMBRE: String = "PRIORIDAD_SUBATENDIDOS"
        {static} private MESES_TRIMESTRE: int = 3
        private recepciones: RepositorioRecepcionesEntidad

        public nombre(): String
        protected prepararPuntaje(donacion: Donacion, entidades: List<EntidadBeneficiaria>): ToDoubleFunction<EntidadBeneficiaria>
        protected calcularPuntaje(donacion: Donacion, entidad: EntidadBeneficiaria): double
    }

    note as NotaAlgoritmos
        Template method: evaluar() puntúa, filtra, ordena y
        recorta al tamaño configurado
        (donaciones.matchmaking.tamanio-ranking).
        SubAtendidos redefine prepararPuntaje para leer en UNA
        consulta las recepciones del trimestre de todas las
        entidades (tabla entidad_recepcion_diaria).
    end note
}

