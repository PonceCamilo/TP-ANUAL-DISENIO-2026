    note as NotaNotificador
        Arma el texto de cada aviso y elige el canal:
        el contacto predeterminado de la persona o, si
        no tiene, su email; para la entidad, su email o
        su primer contacto. Las entregas fallidas
        también avisan a la persona administradora.
        Si la entidad no se encuentra, el aviso de
        asignación a la persona no la nombra.
    end note
}

package salida {

    class BandejaDeSalida {
        private mensajes: MensajeSalienteJpaRepository
        private json: ObjectMapper

        public encolar(destino: String, contenido: Object): void
    }

    class MensajeSaliente <<entidad>> {
        private id: UUID
        private destino: String
        private payload: String
        private estado: EstadoMensaje
        private intentos: int
        private creado: LocalDateTime
        private proximoIntento: LocalDateTime
        private enviado: LocalDateTime
        private ultimoError: String

        {static} public nuevo(destino: String, payload: String, ahora: LocalDateTime): MensajeSaliente
        public marcarEnviado(ahora: LocalDateTime): void
        public registrarFalla(error: String, ahora: LocalDateTime, maxIntentos: int): void
    }

    enum EstadoMensaje <<enum>> {
        PENDIENTE
        ENVIADO
        FALLIDO
    }

    class Destinos {
        {static} public NOTIFICACION: String
        {static} public INCENTIVOS_DONACION_REGISTRADA: String
        {static} public INCENTIVOS_DONACION_EXITOSA: String
    }

    interface EnviadorDeMensajes {
        public destinos(): Set<String>
        public enviar(destino: String, payload: String): void
    }

    class RelayDeMensajes {
        private mensajes: MensajeSalienteJpaRepository
        private enviadores: Map<String, EnviadorDeMensajes>
        private transaccion: TransactionOperations
        private configuracion: DonacionesProperties.Salida

        public enviarPendientes(tiempoMaximo: Duration): int
        private enviarDestino(destino: String, ahora: LocalDateTime, corte: Instant, tiempoMaximo: Duration): int
        public borrarEnviadosAntiguos(): int
    }

    class RelayProgramado {
        {static} ~BLOQUEO_MAXIMO: String = "PT1M"
        {static} ~CORTE: Duration = 30 s
        private relay: RelayDeMensajes

        public enviarPendientes(): void «@Scheduled cada 5 s, @SchedulerLock»
        public borrarEnviadosAntiguos(): void «@Scheduled 0 30 4 * * *, @SchedulerLock»
    }

    note as NotaSalida
        Bandeja de salida (outbox): el aviso se guarda en
        mensaje_saliente en la transacción del cambio. En
        cada corrida, el relay envía cada destino en su
        propio hilo, en orden de llegada y de a lotes de 50,
        por el enviador de ese destino. Si un envío falla, el
        resto de ese destino espera a la corrida siguiente y
        el que falló se reintenta con una espera que se
        duplica (30 s hasta 1 h), hasta 10 intentos; después
        queda FALLIDO. Los enviados se borran a los 7 días.
        ..
        La corrida deja de tomar mensajes a los 30 s (CORTE),
        la mitad de su bloqueo: con los timeouts, el envío
        en curso termina antes de que el bloqueo venza y
        dos instancias nunca envían a la vez.
    end note
}

package clientes {

    class NotificacionClient {
