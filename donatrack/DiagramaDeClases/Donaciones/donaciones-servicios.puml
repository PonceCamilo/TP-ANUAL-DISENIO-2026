    class BrokerLogisticaClient {
        private api: Api

        public solicitarEnvio(proveedor: String, donaciones: List<DonacionEnvio>): ResultadoEnvio
    }

    interface "BrokerLogisticaClient.Api" as BrokerApi {
        public solicitarEnvio(pedido: SolicitudEnvio): ResultadoEnvio «@PostExchange /api/broker/envios»
    }

    class SolicitudEnvio <<record>> {
        proveedor: String
        donaciones: List<DonacionEnvio>
    }

    class DonacionEnvio <<record>> {
        idDonacion: UUID
        idEntidadBeneficiaria: UUID
        nombreEntidad: String
        direccionEntrega: DireccionEnvio
    }

    class DireccionEnvio <<record>> {
        calle: String
        numero: int
        localidad: String
        provincia: String
        codigoPostal: String
    }

    class ResultadoEnvio <<record>> {
        proveedor: String
        proveedoresDescartados: List<String>
        envios: List<EnvioAsignado>
    }

    class EnvioAsignado <<record>> {
        idDonacion: UUID
        proveedor: String
        idSeguimiento: String
        fechaAsignacion: LocalDateTime
    }

    note as NotaClientes
        NotificacionClient e IncentivosClient no llaman a nadie:
        encolan el aviso en la bandeja de salida.
        BrokerLogisticaClient llama directo al broker
        (servicio-broker-logistica, 8087): el despacho
        necesita la respuesta.
    end note
}

