@startuml donaciones-componentes

left to right direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 70
skinparam ArrowColor #4A4A4A

skinparam component {
    BackgroundColor White
    BorderColor #5A5A5A
    BackgroundColor<<externo>> #BFDFF2
    BorderColor<<externo>> #2E6E9E
}

skinparam database {
    BackgroundColor #EAF3E6
    BorderColor #5E8C4A
}

skinparam queue {
    BackgroundColor #FDF6E3
    BorderColor #8B7355
}

' Diagrama de componentes de servicio-donaciones (Entrega 5).
' Muestra las capas internas del servicio, el ORM y la base relacional que
' persiste el dominio, y las integraciones con el resto de DonaTrack.
' Puertos y URLs: docker-compose.yml y application.properties.

actor "Cliente HTTP\n(Postman)" as cliente

interface "REST\n/donantes\n/donaciones\n/entidades" as apiDominio
interface "REST\n/logistica/eventos" as apiEventos

component "servicio-donaciones :8081" as donaciones {

    component "Controllers REST" as controllers
    component "GlobalExceptionHandler" as errores

    component "Services\n(casos de uso)" as services
    component "Procesos nocturnos\n«@Scheduled», zona Argentina\n00:00 inactividad\n03:00 reconciliación de recepciones\n03:30 matchmaking\n04:00 despacho" as crons
    component "Algoritmos de asignación\n(compatibilidad semántica,\nprioridad a sub-atendidas)" as algoritmos
    component "Importación CSV\n(lotes de 500 por transacción)" as csv

    component "Repositories\n(interfaces.repositories +\nadapters)" as repos
    component "ORM\nSpring Data JPA + Hibernate 6\n(ddl-auto=update,\nbatch de 50 sentencias)" as orm

    component "Clientes de integración\n(NotificacionClient, IncentivosClient,\nBrokerLogisticaClient)" as clientes
    component "NotificacionTransport\n(REST | AMQP)" as transporte
}

database "PostgreSQL 16\ndonaciones_db" as db {
    folder "Tablas del dominio\n(normalizadas)" as tablasDominio
    folder "Tablas de lectura\n(desnormalizadas, Entrega 5)\nranking_precalculado, ranking_*\nentidad_recepcion_diaria" as tablasLectura
}

queue "RabbitMQ\nexchange donatrack.notificaciones\ncola notificaciones.queue" as rabbit

component "servicio-notificaciones :8084" as notificaciones <<externo>>
component "servicio-incentivos :8083" as incentivos <<externo>>
component "servicio-broker-logistica :8087" as broker <<externo>>

' ─────────────── ENTRADAS ───────────────

cliente --> apiDominio
apiDominio -- controllers
broker --> apiEventos : callbacks de entrega\n(inicio-ruta, entrega-exitosa,\nentrega-fallida)
apiEventos -- controllers

' ─────────────── CAPAS INTERNAS ───────────────

controllers --> services
controllers --> csv : POST /donantes/import
controllers ..> errores : excepciones → 400 / 404 / 409
crons --> services
services --> algoritmos
services --> repos
csv --> repos
algoritmos --> repos
repos --> orm
orm --> db : JDBC

' ─────────────── SALIDAS ───────────────

services --> clientes
clientes --> transporte
transporte --> rabbit : AMQP (en Docker)
transporte ..> notificaciones : REST POST /notificaciones\n(modo rest, fuera de Docker)
rabbit --> notificaciones : consume
clientes --> incentivos : REST POST /api/incentivos/donantes/...
clientes --> broker : REST POST /api/broker/envios

note bottom of db
    Donaciones sigue en un modelo relacional:
    sus datos son entidades con identidad, relaciones
    obligatorias y reglas de integridad (email único,
    borrados bloqueados con 409). La Entrega 5 agrega
    índices y tablas de lectura derivadas; el documental
    (MongoDB) se usa en logística, no acá.
end note

@enduml
