@startuml donaciones-der

hide circle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 55
skinparam class {
  BackgroundColor<<desnormalizada>> #FFF4D6
  BorderColor<<desnormalizada>> #B8860B
}

' DER físico de la base donaciones_db (PostgreSQL 16), Entrega 5.
' Es el esquema que Hibernate genera a partir de las entidades JPA de
' servicio-donaciones (spring.jpa.hibernate.ddl-auto=update): mismos nombres
' de tabla y columna, mismos tipos, PK, FK, restricciones e índices.

' ─────────────── PERSONAS DONANTES (herencia JOINED) ───────────────

entity persona_donante {
  id : uuid <<PK>>
  --
  tipo_documento : varchar(255)
  numero_documento : varchar(255)
  email : varchar(255) <<UQ>>
  estado : varchar(255) <<NN, IX>>
  ultima_interaccion : timestamp(6) <<IX>>
  direccion_calle : varchar(255)
  direccion_numero : integer
  direccion_codigo_postal : varchar(255)
  localidad_nombre : varchar(255)
  provincia_nombre : varchar(255)
  medio_predeterminado_id : uuid <<FK, UQ>>
}

entity persona_humana {
  id : uuid <<PK, FK>>
  --
  nombre : varchar(255)
  apellido : varchar(255)
  fecha_nacimiento : date
  genero : varchar(255) <<CK>>
}

entity persona_juridica {
  id : uuid <<PK, FK>>
  --
  razon_social : varchar(255)
  tipo : varchar(255) <<CK>>
  rubro : varchar(255)
}

' ─────────────── COMPARTIDAS PERSONA / ENTIDAD ───────────────

entity representante {
  id : uuid <<PK>>
  --
  nombre : varchar(255)
  apellido : varchar(255)
  email : varchar(255)
  persona_juridica_id : uuid <<FK, IX>>
  entidad_id : uuid <<FK, IX>>
}

entity medio_de_contacto {
  id : uuid <<PK>>
  --
  tipo_medio : varchar(31) <<NN>>
  valor : varchar(255)
  persona_donante_id : uuid <<FK, IX>>
  representante_id : uuid <<FK, IX>>
  entidad_id : uuid <<FK, IX>>
}

' ─────────────── ENTIDADES BENEFICIARIAS ───────────────

entity entidad_beneficiaria {
  id : uuid <<PK>>
  --
  razon_social : varchar(255)
  direccion_calle : varchar(255)
  direccion_numero : integer
  direccion_codigo_postal : varchar(255)
  localidad_nombre : varchar(255)
  provincia_nombre : varchar(255)
}

entity campania {
  id_campania : uuid <<PK>>
  --
  fecha_inicio : date
  fecha_fin : date
  descripcion_general : varchar(1000)
  entidad_id : uuid <<FK, IX>>
}

entity necesidad {
  id : uuid <<PK>>
  --
  nombre : varchar(255)
  descripcion : varchar(1000)
  fecha_registro : date
  cantidad_objetivo : integer
  cantidad_recibida : integer
  campania_id : uuid <<FK, IX>>
}

entity necesidad_extraordinaria {
  id : uuid <<PK, FK>>
}

entity necesidad_recurrente {
  id : uuid <<PK, FK>>
  --
  periodo : varchar(255) <<CK>>
  fecha_inicio_periodo : date
}

' ─────────────── DONACIONES ───────────────

entity donacion {
  id : uuid <<PK>>
  --
  estado : varchar(255) <<NN, IX, D>>
  descripcion : varchar(1000)
  fecha_donacion : timestamp(6) <<IX>>
  fecha_asignacion : date <<IX>>
  subcategoria_tipo : varchar(255) <<D>>
  subcategoria_tipo_normalizado : varchar(255) <<IX, D>>
  id_donante : uuid <<IX>>
  id_entidad_beneficiaria : uuid <<IX>>
  proveedor_logistica : varchar(255)
  id_seguimiento_logistica : varchar(255)
}

entity bien {
  id : uuid <<PK>>
  --
  tipo_bien : varchar(31) <<NN>>
  descripcion : varchar(255)
  foto : varchar(255)
  cantidad : integer
  unidad : varchar(255)
  subcategoria_tipo : varchar(255)
  subcategoria_tipo_normalizado : varchar(255)
  es_nuevo : boolean
  fecha_vencimiento : date
  donacion_id : uuid <<FK, IX>>
}

entity cambio_estado {
  id : uuid <<PK>>
  --
  estado_previo : varchar(255)
  estado : varchar(255) <<NN>>
  nombre_transicion : varchar(255)
  justificacion : varchar(1000)
  fecha_hora : timestamp(6) <<NN>>
  donacion_id : uuid <<FK, IX>>
}

' ─────────────── TABLAS DE LECTURA (Entrega 5) ───────────────

entity ranking_precalculado <<desnormalizada>> {
  id_donacion : uuid <<PK>>
  --
  fecha_calculo : timestamp(6)
}

entity ranking_coincidencia <<desnormalizada>> {
  id_donacion : uuid <<PK, FK>>
  posicion : integer <<PK>>
  --
  id_entidad : uuid
  puntaje : float(53)
}

entity ranking_semantico <<desnormalizada>> {
  id_donacion : uuid <<PK, FK>>
  posicion : integer <<PK>>
  --
  id_entidad : uuid
  puntaje : float(53)
}

entity ranking_subatendidos <<desnormalizada>> {
  id_donacion : uuid <<PK, FK>>
  posicion : integer <<PK>>
  --
  id_entidad : uuid
  puntaje : float(53)
}

entity entidad_recepcion_diaria <<desnormalizada>> {
  entidad_id : uuid <<PK>>
  fecha : date <<PK, IX>>
  --
  cantidad : bigint <<NN>>
}

' ─────────────── RELACIONES (FK reales) ───────────────
' Las FK de las colecciones (@OneToMany + @JoinColumn) son nullable,
' por eso el lado de la tabla referenciada se marca 0..1 (|o).

persona_donante ||--o| persona_humana
persona_donante ||--o| persona_juridica

' Solo se rotulan las dos relaciones entre persona_donante y medio_de_contacto,
' que son las únicas que unen el mismo par de tablas.

persona_donante |o--o{ medio_de_contacto : persona_donante_id
medio_de_contacto |o--o| persona_donante : medio_predeterminado_id
persona_juridica |o--o{ representante
representante |o--o{ medio_de_contacto

entidad_beneficiaria |o--o{ medio_de_contacto
entidad_beneficiaria |o--o{ representante
entidad_beneficiaria |o--o{ campania
campania |o--o{ necesidad
necesidad ||--o| necesidad_extraordinaria
necesidad ||--o| necesidad_recurrente

donacion |o--o{ bien
donacion |o--o{ cambio_estado

ranking_precalculado ||--o{ ranking_coincidencia
ranking_precalculado ||--o{ ranking_semantico
ranking_precalculado ||--o{ ranking_subatendidos

' ─────────────── REFERENCIAS POR ID SIN FK ───────────────

persona_donante |o..o{ donacion
entidad_beneficiaria |o..o{ donacion
donacion |o..o| ranking_precalculado
entidad_beneficiaria |o..o{ entidad_recepcion_diaria

legend right
  <b>Referencias</b>
  PK: clave primaria · FK: clave foránea · UQ: única · NN: NOT NULL · CK: CHECK
  IX: columna con índice · D: dato derivado (desnormalización)
  Línea continua: FK real · línea punteada: referencia por id sin FK
  Tablas en amarillo: tablas de lectura desnormalizadas (Entrega 5)
  ----
  <b>Índices (Entrega 5)</b>
  donacion: (estado) · (id_donante, estado) · (id_entidad_beneficiaria, fecha_asignacion)
             (subcategoria_tipo_normalizado) · (fecha_donacion DESC, id)
  persona_donante: (estado) · (ultima_interaccion) · email UNIQUE
  Columnas FK de las colecciones: bien, cambio_estado, medio_de_contacto,
             representante, campania, necesidad · entidad_recepcion_diaria: (fecha)
  ----
  <b>Desnormalizaciones</b>
  ranking_*: ranking del matchmaking nocturno, precalculado (derivable de donaciones y necesidades)
  entidad_recepcion_diaria: donaciones asignadas por entidad y día (derivable de donacion);
             se mantiene en la misma transacción que la asignación y se reconcilia cada noche
  donacion.estado: estado actual (derivable del último cambio_estado)
  donacion.subcategoria_*: subcategoría de sus bienes · *_tipo_normalizado: forma de búsqueda
  ----
  <b>Integridad</b>
  persona_donante.email: identidad de la persona, UNIQUE, guardada en forma canónica
             (trim, NFC, minúsculas); no cambia después del alta
  Borrar una persona o entidad con donaciones se rechaza con 409 (no hay FK hacia donacion)
  ----
  <b>CHECK</b>
  persona_humana.genero ∈ {MASCULINO, FEMENINO, NO_BINARIO, OTRO, PREFIERO_NO_DECIR}
  persona_juridica.tipo ∈ {GUBERNAMENTAL, ONG, EMPRESA, INSTITUCION}
  necesidad_recurrente.periodo ∈ {SEMANAL, MENSUAL, CUATRIMESTRAL, ANUAL}
  ----
  <b>Herencia</b>
  JOINED: persona_donante → persona_humana | persona_juridica
             necesidad → necesidad_extraordinaria | necesidad_recurrente
  SINGLE_TABLE (discriminador):
             bien.tipo_bien ∈ {PERECIBLE, CON_ESTADO, GENERICO}
             medio_de_contacto.tipo_medio ∈ {EMAIL, TELEFONO, WHATSAPP}
  ----
  <b>Notas</b>
  estado / estado_previo guardan el nombre del objeto State (EN_DEPOSITO, ACTIVO, ...).
  Direccion (con Localidad y Provincia) y Subcategoria son @Embeddable:
  sus columnas viven en la tabla que las contiene.
  No se persiste CargaDonacion (objeto de un solo uso para segmentar).
endlegend

@enduml
