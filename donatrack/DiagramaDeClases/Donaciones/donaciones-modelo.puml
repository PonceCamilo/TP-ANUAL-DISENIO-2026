@startuml donaciones-modelo

abstract class PersonaDonante {
    private tipoDocumento: String
    private numeroDocumento: String
    private direccion: Direccion
    private estado: EstadoDonante
    private medioContactoPredeterminado: MedioDeContacto
    private ultimaInteraccion: LocalDateTime
    private email: String
    private contactos: List<MedioDeContacto>
}

class PersonaHumana {
    private nombre: String
    private apellido: String
    private fechaNacimiento: LocalDate
    private genero: Genero
}

class PersonaJuridica {
    private razonSocial: String
    private tipo: TipoPersonaJuridica
    private rubro: String
    private representantes: List<Representante>
}

class Representante {
    private nombre: String
    private apellido: String
    private email: String
    private contactos: List<MedioDeContacto>
}

enum EstadoDonante {
    ACTIVO
    INACTIVO
    BLOQUEADO
}

enum Genero {
    MASCULINO
    FEMENINO
    NO_BINARIO
    OTRO
    PREFIERO_NO_DECIR
}

enum TipoPersonaJuridica {
    GUBERNAMENTAL
    ONG
    EMPRESA
    INSTITUCION
}

abstract class MedioDeContacto {
    private valor: String
}

class Email {
}

class Telefono {
}

class Whatsapp {
}

class Donacion {
    private bienes: List<Bien>
    private subcategoria: Subcategoria
    private estado: EstadoDonacionBase
    private historialEstados: List<CambioEstado>
    private idDonante: UUID
    private idEntidadBeneficiaria: UUID
    private descripcion: String
    private fechaDonacion: LocalDateTime
    private fechaAsignacion: LocalDate

    public cambiarEstado(estadoDestino: String, nombreTransicion: String, justificacion: String): void
    public esPerecible(): boolean
    public requiereEstado(): boolean
}

class CargaDonacion {
    private idDonante: UUID
    private descripcion: String
    private bienes: List<Bien>
}

class CambioEstado {
    private estadoPrevio: EstadoDonacionBase
    private estado: EstadoDonacionBase
    private nombreTransicion: String
    private justificacion: String
    private fechaHora: LocalDateTime
}

abstract class EstadoDonacionBase {
    private nombre: String
    private transiciones: Map<String, Supplier<EstadoDonacionBase>>

    public transicionarA(estadoDestino: String, justificacion: String): EstadoDonacionBase
    public nombre(): String
}

class EnDepositoState {
}

class AsignacionRealizadaState {
}

class ListaParaEntregarState {
}

class EnTrasladoState {
    public transicionarA(estadoDestino: String, justificacion: String): EstadoDonacionBase
}

class EntregadaState {
}

class EntregaFallidaState {
}

class VencidaState {
}

abstract class Bien {
    private subcategoria: Subcategoria
    private descripcion: String
    private foto: String
    private cantidad: int
    private unidad: String
}

class BienGenerico {
}

class BienConEstado {
    private esNuevo: boolean
}

class BienPerecible {
    private fechaVencimiento: LocalDate
}

class Categoria {
    private nombre: String
    private tipoBien: TipoBien
    private subcategorias: List<Subcategoria>
}

class Subcategoria {
    private tipo: String
    private tipoNormalizado: String

    public toString(): String
}

enum TipoBien {
    PERECIBLE
    CON_ESTADO
    GENERICO
}

class EntidadBeneficiaria {
    private razonSocial: String
    private direccion: Direccion
    private contactos: List<MedioDeContacto>
    private representantes: List<Representante>
    private campanias: List<Campania>

    public agregarCampania(campania: Campania): void
    public agregarNecesidadACampania(campania: Campania, necesidad: Necesidad): void
}

class Direccion {
    private calle: String
    private numero: int
    private localidad: Localidad
    private codigoPostal: String
}

class Localidad {
    private nombre: String
    private provincia: Provincia
}

class Provincia {
    private nombre: String
}

class Campania {
    private idEntidad: UUID
    private fechaInicio: LocalDate
    private fechaFin: LocalDate
    private descripcionGeneral: String
    private idCampania: UUID
    private necesidades: List<Necesidad>
}

abstract class Necesidad {
    private nombre: String
    private descripcion: String
    private fechaRegistro: LocalDate
    private cantidadObjetivo: int
    private cantidadRecibida: int

    public recibirDonacion(cantidad: int): void
    public estaSatisfecha(): boolean
}

class NecesidadExtraordinaria {
    public estaSatisfecha(): boolean
}

class NecesidadRecurrente {
    private periodo: Periodicidad
    private fechaInicioPeriodo: LocalDate

    public periodoVencido(referencia: LocalDate): boolean
    public obtenerOGenerarPeriodoActual(hoy: LocalDate): void
    public estaSatisfecha(): boolean
}

enum Periodicidad {
    SEMANAL
    MENSUAL
    CUATRIMESTRAL
    ANUAL

    public getDias(): int
}

class ResultadoAsignacion {
    private idEntidad: UUID
    private puntaje: double
}

PersonaHumana --|> PersonaDonante
PersonaJuridica --|> PersonaDonante
Email --|> MedioDeContacto
Telefono --|> MedioDeContacto
Whatsapp --|> MedioDeContacto
BienGenerico --|> Bien
BienConEstado --|> Bien
BienPerecible --|> Bien
EnDepositoState --|> EstadoDonacionBase
AsignacionRealizadaState --|> EstadoDonacionBase
ListaParaEntregarState --|> EstadoDonacionBase
EnTrasladoState --|> EstadoDonacionBase
EntregadaState --|> EstadoDonacionBase
EntregaFallidaState --|> EstadoDonacionBase
VencidaState --|> EstadoDonacionBase
NecesidadExtraordinaria --|> Necesidad
NecesidadRecurrente --|> Necesidad

PersonaDonante -- EstadoDonante
PersonaDonante -- Direccion
PersonaDonante -- MedioDeContacto
PersonaHumana -- Genero
PersonaJuridica -- TipoPersonaJuridica
PersonaJuridica -- Representante
Representante -- MedioDeContacto

Donacion -- Bien
Donacion -- CambioEstado
Donacion -- EstadoDonacionBase
Donacion -- Subcategoria
Donacion -- PersonaDonante
Donacion -- EntidadBeneficiaria
CargaDonacion -- Bien
CambioEstado -- EstadoDonacionBase
Bien -- Subcategoria

Categoria -- Subcategoria
Categoria -- TipoBien

EntidadBeneficiaria -- Direccion
EntidadBeneficiaria -- MedioDeContacto
EntidadBeneficiaria -- Representante
EntidadBeneficiaria -- Campania
Campania -- Necesidad
NecesidadRecurrente -- Periodicidad
Direccion -- Localidad
Localidad -- Provincia

ResultadoAsignacion -- EntidadBeneficiaria

@enduml
