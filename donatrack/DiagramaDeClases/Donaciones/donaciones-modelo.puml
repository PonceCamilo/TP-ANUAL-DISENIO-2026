' Modelo de dominio de servicio-donaciones (paquete ar.utn.donatrack.donaciones.models).
' No se dibujan getters/setters/builders generados por Lombok.
' {transient}: atributo @Transient (no se persiste). <<embeddable>>: @Embeddable.
' <<valor>>: objeto de valor que no se persiste aparte (record o snapshot).
' {unique}: columna con UNIQUE en la base. {readOnly}: se lee de la base, no se escribe.
' <<desnormalizada>>: tabla de lectura derivable de otras (Entrega 5).
' <<evento>>: evento de dominio que registra el agregado y Spring publica al guardarlo.

interface "Persistable<UUID>" as Persistable <<interface>> {
    public getId(): UUID
    public isNew(): boolean
}

abstract class EntidadPersistible <<abstracta>> {
    protected id: UUID
    protected version: long «@Version»
    protected nueva: boolean {transient}
    private eventos: List<Object> {transient}

    public isNew(): boolean
    protected registrarEvento(evento: Object): void
    public eventosPendientes(): List<Object> «@DomainEvents»
    protected limpiarEventos(): void «@AfterDomainEventPublication»
    ~marcarComoPersistida(): void «@PostLoad, @PostPersist»
}

note top of EntidadPersistible
    Base de las raíces de agregado (Entrega 5).
    id asignado por la aplicación + isNew():
    sin SELECT previo a cada INSERT.
    version: bloqueo optimista (409 si dos
    pedidos modifican lo mismo a la vez).
    eventos: se publican al guardar el agregado.
end note

package estado {

    abstract class "Estado<E>" as Estado <<abstracta>> {
        private nombre: String
        private transiciones: Map<String, Supplier<E>>

        public transicionarA(estadoDestino: String, justificacion: String): E {final}
        protected validarTransicion(estadoDestino: String, justificacion: String): void
        public nombre(): String
        public es(nombreEstado: String): boolean
    }

    class "CatalogoDeEstados<E>" as Catalogo {
        private porNombre: Map<String, Supplier<E>>

        public desde(nombre: String): E
    }

    note as NotaEstado
        Base común de los estados de la donación
        y de la persona donante (patrón State).
        Cada estado declara a dónde puede pasar;
        validarTransicion es el gancho para sus
        reglas propias. Se guarda solo el nombre.
        ..
        transición no declarada → TransicionDeEstadoIlegalException
        nombre desconocido → EstadoDesconocidoException
    end note

    NotaEstado .. Estado
}

package donante {

    abstract class PersonaDonante <<abstracta>> {
        protected documento: Documento
        protected direccion: Direccion
        protected estadoNombre: String
        protected ultimaInteraccion: LocalDateTime
        protected ultimoAvisoInactividad: LocalDateTime
        protected email: String {unique}
        protected contactos: List<MedioDeContacto>

        public getEstado(): EstadoDonante
        public cambiarEstado(estadoDestino: String, justificacion: String): void
        public estaBloqueada(): boolean
        public registrarInteraccion(): void
        public reemplazarContacto(medio: MedioDeContacto): void
        public reemplazarContactos(nuevos: List<MedioDeContacto>): void
        public definirContactoPredeterminado(medio: MedioDeContacto): void
        public getMedioContactoPredeterminado(): MedioDeContacto
        public cambiarDireccion(direccion: Direccion): void
        public cambiarDocumento(documento: Documento): void
        {abstract} public tipoPersona(): TipoPersona
        {abstract} public actualizarNombreImportado(nombre: String): void
        private normalizarEmail(): void «@PrePersist, @PreUpdate»
    }

    note as NotaEmailDonante
        email: identidad de la persona.
        Se fija en el alta y no cambia después.
        Se guarda en forma canónica
        (NormalizadorEmail: trim, NFC, minúsculas)
        y la base garantiza que sea único.
        ..
        Sin setters: cada dato que se puede cambiar
        tiene su método; las listas son de solo lectura.
    end note

    NotaEmailDonante .. PersonaDonante

    class PersonaHumana {
        private nombre: String
        private apellido: String
        private fechaNacimiento: LocalDate
        private genero: Genero

        public actualizarDatosPersonales(nombre, apellido, fechaNacimiento, genero): void
    }

    class PersonaJuridica {
        private razonSocial: String
        private tipo: TipoPersonaJuridica
        private rubro: String
        private representantes: List<Representante>

        public agregarRepresentante(representante: Representante): void
        public actualizarDatosDeOrganizacion(razonSocial, rubro, tipo): void
    }

    class Representante {
        private id: UUID
        private nombre: String
        private apellido: String
        private email: String
        private contactos: List<MedioDeContacto>

        ~normalizarEmail(): void «@PrePersist, @PreUpdate»
    }

    class Documento <<embeddable>> {
        private tipo: String
        private numero: String

        {static} public de(tipo: String, numero: String): Documento
        {static} public deOrganizacion(tipo: String, numero: String): Documento
    }

    enum TipoDocumento <<enum>> {
        DNI
        LC
        LE
        CUIT
        CUIL
        PASAPORTE
        --
        public normalizar(numero: String): String
        public esValido(numeroNormalizado: String): boolean
    }

    note as NotaDocumento
        Tipo y número se validan juntos:
        DNI de 7 u 8 dígitos, CUIT/CUIL con
        dígito verificador, ... El número se
        guarda sin puntos ni guiones.
        Una organización tiene que tener CUIT.
        Inválido → DocumentoInvalidoException (400)
    end note

    NotaDocumento .. Documento

    enum Genero <<enum>> {
        MASCULINO
        FEMENINO
        NO_BINARIO
        OTRO
        PREFIERO_NO_DECIR
    }

    enum TipoPersonaJuridica <<enum>> {
        GUBERNAMENTAL
        ONG
        EMPRESA
        INSTITUCION
    }

    enum TipoPersona <<enum>> {
        HUMANA
        JURIDICA
    }

    package "estado " as estadoDonante {

        abstract class EstadoDonante <<abstracta>> {
            protected validarTransicion(estadoDestino: String, justificacion: String): void
        }

        class ActivoState {
            protected validarTransicion(estadoDestino: String, justificacion: String): void
        }

        class InactivoState {
        }

        class BloqueadoState {
        }

        class EstadosDonante {
            {static} public ACTIVO: String
            {static} public INACTIVO: String
            {static} public BLOQUEADO: String

            {static} public inicial(): EstadoDonante
            {static} public desde(nombre: String): EstadoDonante
        }

        note as NotaEstadosDonante
            Transiciones válidas (estado inicial: ACTIVO):
            ACTIVO → INACTIVO | BLOQUEADO
            INACTIVO → ACTIVO
            BLOQUEADO → ACTIVO
            ..
            mismo estado → PersonaConMismoEstadoException
            BLOQUEADO sin justificación → FaltaJustificacionException
            Una persona BLOQUEADA no registra donaciones (422).
        end note
    }
}

package contacto {

    abstract class MedioDeContacto <<abstracta>> {
        protected id: UUID
        protected valor: String
        protected predeterminado: boolean

        {abstract} public canal(): Canal
        public marcarComoPredeterminado(valor: boolean): void
        public esDelMismoTipoQue(otro: MedioDeContacto): boolean
    }

    class Email {
        public canal(): Canal
        private normalizarValor(): void «@PrePersist, @PreUpdate»
    }

    class Telefono {
        public canal(): Canal
    }

    class Whatsapp {
        public canal(): Canal
    }

    enum Canal <<enum>> {
        EMAIL
        SMS
        WHATSAPP
    }
}

package donacion {

    class Donacion {
        protected bienes: List<Bien>
        protected subcategoria: Subcategoria
        protected estadoNombre: String
        protected historialEstados: List<CambioEstado>
        protected idDonante: UUID
        protected idEntidadBeneficiaria: UUID
        protected descripcion: String
        protected fechaDonacion: LocalDateTime
        protected fechaAsignacion: LocalDate
        protected proveedorLogistica: ProveedorLogistica
        protected idSeguimientoLogistica: String
        protected fechaBaja: LocalDateTime
        private asignacionGuardada: Asignacion {transient}

        public getEstado(): EstadoDonacionBase
        public cambiarEstado(estadoDestino, nombreTransicion, justificacion): void
        public cambiarEstadoManualmente(estadoDestino, justificacion): void
        public asignarA(entidad: EntidadBeneficiaria): void
        public asignacion(): Asignacion
        public cambioLaAsignacion(): boolean
        public despacharA(proveedor: ProveedorLogistica, idSeguimiento: String): void
        public iniciarTraslado(justificacion: String): boolean
        public registrarEntrega(fechaEntrega: LocalDateTime, justificacion: String): boolean
        public registrarEntregaFallida(justificacion: String): boolean
        public darDeBaja(): void
        public agregarBien(bien: Bien): void
        public reemplazarBien(idBien: UUID, nuevo: Bien): void
        public tieneBienesVencidosAl(fecha: LocalDate): boolean
        public exigirSinBienesVencidosAl(fecha: LocalDate): void
        public estaEnEstado(nombreEstado: String): boolean
        public cantidadTotal(): int
        +marcarAsignacionGuardada(): void «@PostLoad, @PostPersist, @PostUpdate»
    }

    note as NotaDonacion
        Baja lógica: fecha_baja + @SQLRestriction,
        una donación dada de baja no aparece en
        ninguna consulta.
        ..
        Los avisos de logística son idempotentes:
        iniciarTraslado / registrarEntrega /
        registrarEntregaFallida devuelven false si
        el aviso ya se había procesado.
        ..
        A ASIGNACION_REALIZADA solo se llega con
        asignarA (el cambio manual la rechaza).
    end note

    NotaDonacion .. Donacion

    class Asignacion <<valor>> {
        idEntidad: UUID
        fecha: LocalDate
        --
        {static} NINGUNA: Asignacion
        public existe(): boolean
    }

    enum ProveedorLogistica <<enum>> {
        DONATRACK
        EXTERNA
    }

    class CargaDonacion {
        private idDonante: UUID
        private descripcion: String
        private bienes: List<Bien>

        public segmentar(): List<Donacion>
    }

    class CambioEstado {
        private id: UUID
        private estadoPrevioNombre: String
        private estadoNombre: String
        private nombreTransicion: String
        private justificacion: String
        private fechaHora: LocalDateTime

        {static} public de(estadoPrevio, estado, nombreTransicion, justificacion): CambioEstado
        public getEstadoPrevio(): EstadoDonacionBase
        public getEstado(): EstadoDonacionBase
    }

    package "estado  " as estadoDonacion {

        abstract class EstadoDonacionBase <<abstracta>> {
        }

        class EnDepositoState {
        }

        class AsignacionRealizadaState {
        }

        class ListaParaEntregarState {
        }

        class EnTrasladoState {
            protected validarTransicion(estadoDestino: String, justificacion: String): void
        }

        class EntregadaState {
        }

        class EntregaFallidaState {
        }

        class VencidaState {
        }

        class EstadosDonacion {
            {static} public EN_DEPOSITO, ASIGNACION_REALIZADA, ...: String

            {static} public inicial(): EstadoDonacionBase
            {static} public desde(nombre: String): EstadoDonacionBase
            {static} public desdeONull(nombre: String): EstadoDonacionBase
        }

        note as NotaEstadosDonacion
            Transiciones válidas (estado inicial: EN_DEPOSITO):
            EN_DEPOSITO → ASIGNACION_REALIZADA | VENCIDA
            ASIGNACION_REALIZADA → LISTA_PARA_ENTREGAR
            LISTA_PARA_ENTREGAR → EN_TRASLADO
            EN_TRASLADO → ENTREGADA | ENTREGA_FALLIDA
            ENTREGA_FALLIDA → EN_DEPOSITO | EN_TRASLADO
            ENTREGADA y VENCIDA son finales
            ..
            ENTREGA_FALLIDA sin justificación → FaltaJustificacionException
            ASIGNACION_REALIZADA a mano → TransicionReservadaException
        end note
    }

    package bien {

        abstract class Bien <<abstracta>> {
            protected id: UUID
            protected subcategoria: Subcategoria
            protected descripcion: String
            protected foto: String
            protected cantidad: int
            protected unidad: String

            {abstract} public tipo(): TipoBien
            public vencimiento(): Optional<LocalDate>
            public nuevo(): Optional<Boolean>
            public claveDeSegmentacion(): ClaveDeSegmentacion
            {abstract} protected criterioDeSegmentacion(): Object
        }

        class BienGenerico {
        }

        class BienConEstado {
            private esNuevo: boolean
        }

        class BienPerecible {
            private fechaVencimiento: LocalDate
        }

        enum TipoBien <<enum>> {
            PERECIBLE
            CON_ESTADO
            GENERICO
        }

        class "Bien.ClaveDeSegmentacion" as ClaveDeSegmentacion <<valor>> {
            subcategoria: Subcategoria
            tipo: TipoBien
            criterio: Object
        }
    }

    package eventos {

        class DonacionCambioDeEstado <<evento>> {
            idDonacion: UUID
            estadoPrevio: String
            estadoNuevo: String
        }

        class DonacionAsignada <<evento>> {
            idDonacion: UUID
            idDonante: UUID
            idEntidad: UUID
        }

        class DonacionEntregada <<evento>> {
            idDonacion, idDonante, idEntidad: UUID
            subcategoria: Subcategoria
            cantidad: int
            fechaEntrega: LocalDateTime
        }

        class DonacionDadaDeBaja <<evento>> {
            idDonacion: UUID
        }

        class DonacionesRegistradas <<evento>> {
            idDonante: UUID
            cantidadBienes: int
            categorias: List<String>
            cuando: LocalDateTime
        }
    }
}

package categoria {

    class Subcategoria <<embeddable>> {
        private tipo: String
        private tipoNormalizado: String

        public estaVacia(): boolean
        public coincideCon(otra: Subcategoria): boolean
        public estaMencionadaEn(texto: String): boolean
    }

    note as NotaSubcategoria
        Compara por tipoNormalizado (NormalizadorTexto:
        minúsculas, sin acentos, espacios colapsados),
        que es también la columna indexada para buscar.
    end note

    NotaSubcategoria .. Subcategoria
}

package entidad {

    class EntidadBeneficiaria {
        private razonSocial: String
        private direccion: Direccion
        private contactos: List<MedioDeContacto>
        private representantes: List<Representante>
        private campanias: List<Campania>

        public cambiarRazonSocial(razonSocial: String): void
        public cambiarDireccion(direccion: Direccion): void
        public reemplazarContactos(nuevos: List<MedioDeContacto>): void
        public reemplazarRepresentantes(nuevos: List<Representante>): void
        public agregarCampania(campania: Campania): void
        public contactoParaNotificar(): Optional<MedioDeContacto>
        public contarNecesidadesCompatiblesCon(subcategoria: Subcategoria, fecha: LocalDate): int
        public recibirDonacion(donacion: Donacion, fecha: LocalDate): int
    }

    class Direccion <<embeddable>> {
        private calle: String
        private numero: int
        private localidad: Localidad
        private codigoPostal: String
    }

    class Localidad <<embeddable>> {
        private nombre: String
        private provincia: Provincia
    }

    class Provincia <<embeddable>> {
        private nombre: String
    }

    package necesidad {

        class Campania {
            private idCampania: UUID
            private idEntidad: UUID {readOnly}
            private fechaInicio: LocalDate
            private fechaFin: LocalDate
            private descripcionGeneral: String
            private necesidades: List<Necesidad>

            public agregarNecesidad(necesidad: Necesidad): void
            public buscarNecesidad(necesidadId: UUID): Optional<Necesidad>
            public eliminarNecesidad(necesidadId: UUID): boolean
            public estaVigenteAl(fecha: LocalDate): boolean
            public necesidadesAbiertasCompatiblesCon(subcategoria: Subcategoria, fecha: LocalDate): List<Necesidad>
        }

        abstract class Necesidad <<abstracta>> {
            protected id: UUID
            protected nombre: String
            protected descripcion: String
            protected subcategoria: Subcategoria
            protected fechaRegistro: LocalDate
            protected cantidadObjetivo: int
            protected cantidadRecibida: int

            {abstract} public tipo(): TipoNecesidad
            public actualizarDatos(nombre, descripcion, cantidadObjetivo, subcategoria): void
            public recibir(cantidad: int, fecha: LocalDate): void
            public faltanteAl(fecha: LocalDate): int
            public cantidadRecibidaAl(fecha: LocalDate): int
            public estaSatisfechaAl(fecha: LocalDate): boolean
            public esCompatibleCon(buscada: Subcategoria): boolean
        }

        class NecesidadExtraordinaria {
        }

        class NecesidadRecurrente {
            private periodo: Periodicidad
            private fechaInicioPeriodo: LocalDate

            public periodoVencido(referencia: LocalDate): boolean
            public actualizarPeriodo(hoy: LocalDate): void
            public recibir(cantidad: int, fecha: LocalDate): void
            public cantidadRecibidaAl(fecha: LocalDate): int
        }

        enum TipoNecesidad <<enum>> {
            EXTRAORDINARIA
            RECURRENTE
        }

        note as NotaNecesidades
            Al entregarse una donación, su cantidad se
            imputa a las necesidades abiertas compatibles
            de la entidad, en orden (recibirDonacion).
            Una recurrente vuelve a cero al empezar cada
            período, que avanza de a períodos enteros.
            Sin subcategoría, la compatibilidad se busca
            en el nombre y la descripción.
        end note

        package periodicidades {

            enum Periodicidad <<enum>> {
                {field} SEMANAL(1 semana)
                {field} MENSUAL(1 mes)
                {field} CUATRIMESTRAL(4 meses)
                {field} ANUAL(1 año)
                --
                private duracion: Period

                public finDelPeriodo(inicio: LocalDate): LocalDate
                public inicioDelPeriodoVigente(inicio: LocalDate, fecha: LocalDate): LocalDate
            }
        }
    }
}

package asignacion {

    class ResultadoAsignacion <<embeddable>> {
        private idEntidad: UUID
        private puntaje: double
    }

    class ResultadoMatchmaking <<valor>> {
        rankings: Map<String, List<ResultadoAsignacion>>
        --
        public ranking(algoritmo: String): List<ResultadoAsignacion>
        public coincidencias(): List<ResultadoAsignacion>
        public huboCoincidencias(): boolean
        public sinCandidatas(): boolean
    }

    class RankingPrecalculado <<desnormalizada>> {
        private idDonacion: UUID
        private puestos: List<PuestoRanking>
        private fechaCalculo: LocalDateTime
        private nuevo: boolean {transient}

        {static} public de(idDonacion, resultado, fechaCalculo): RankingPrecalculado
        public resultado(): ResultadoMatchmaking
        public huboCoincidencias(): boolean
        public sinCandidatas(): boolean
    }

    class PuestoRanking <<embeddable>> {
        private algoritmo: String
        private posicion: int
        private resultado: ResultadoAsignacion
    }

    class RecepcionDiariaEntidad <<desnormalizada>> {
        private clave: Clave
        private cantidad: long
    }

    class "RecepcionDiariaEntidad.Clave" as ClaveRecepcion <<embeddable>> {
        private idEntidad: UUID
        private fecha: LocalDate
    }

    note as NotaAsignacion
        Tablas de lectura de la Entrega 5:
        derivables de donacion y necesidad.
        ..
        RankingPrecalculado: lo escribe el proceso
        nocturno de matchmaking; la bandeja lo lee
        tal cual. Un puesto por algoritmo y posición:
        un algoritmo nuevo no cambia el esquema. Las
        coincidencias se derivan de los rankings.
        ..
        RecepcionDiariaEntidad: donaciones asignadas
        por entidad y día. Se actualiza en la misma
        transacción que la asignación y se reconcilia
        cada noche desde la tabla donacion.
    end note
}

' ─────────────── HERENCIA ───────────────

EntidadPersistible ..|> Persistable
RankingPrecalculado ..|> Persistable
PersonaDonante --|> EntidadPersistible
Donacion --|> EntidadPersistible
EntidadBeneficiaria --|> EntidadPersistible
PersonaHumana --|> PersonaDonante
PersonaJuridica --|> PersonaDonante
EstadoDonante --|> Estado
EstadoDonacionBase --|> Estado
ActivoState --|> EstadoDonante
InactivoState --|> EstadoDonante
BloqueadoState --|> EstadoDonante
Email --|> MedioDeContacto
Telefono --|> MedioDeContacto
Whatsapp --|> MedioDeContacto
BienGenerico --|> Bien
BienConEstado --|> Bien
BienPerecible --|> Bien
EnDepositoState --|> EstadoDonacionBase
AsignacionRealizadaState --|> EstadoDonacionBase
ListaParaEntregarState --|> EstadoDonacionBase
EnTrasladoState --|> EstadoDonacionBase
EntregadaState --|> EstadoDonacionBase
EntregaFallidaState --|> EstadoDonacionBase
VencidaState --|> EstadoDonacionBase
NecesidadExtraordinaria --|> Necesidad
NecesidadRecurrente --|> Necesidad

' ─────────────── DONANTES Y CONTACTOS ───────────────
' Composición (*--): colecciones con cascade ALL + orphanRemoval y objetos @Embeddable.

PersonaDonante *-- "0..1" Documento
PersonaDonante *-- "0..1" Direccion
PersonaDonante --> "1" EstadoDonante
PersonaDonante *-- "0..*\ncontactos" MedioDeContacto
PersonaDonante ..> EstadosDonante
Documento ..> TipoDocumento
PersonaHumana --> "0..1" Genero
PersonaJuridica --> "0..1" TipoPersonaJuridica
PersonaDonante ..> TipoPersona
PersonaJuridica *-- "0..*" Representante
Representante *-- "0..*" MedioDeContacto
MedioDeContacto ..> Canal
EstadosDonante ..> Catalogo
Catalogo ..> Estado : <<crea>>

' ─────────────── DONACIONES ───────────────

Donacion *-- "0..*" Bien
Donacion *-- "0..*\n{ordered}" CambioEstado
Donacion --> "1" EstadoDonacionBase
Donacion *-- "0..1" Subcategoria
Donacion --> "0..1" ProveedorLogistica
Donacion ..> Asignacion
Donacion ..> EstadosDonacion
Donacion ..> EntidadBeneficiaria : asignarA()
Donacion ..> DonacionCambioDeEstado : <<registra>>
Donacion ..> DonacionAsignada : <<registra>>
Donacion ..> DonacionEntregada : <<registra>>
Donacion ..> DonacionDadaDeBaja : <<registra>>
CargaDonacion --> "0..*" Bien
CargaDonacion ..> Donacion : <<crea>>
CambioEstado ..> EstadosDonacion
EstadosDonacion ..> Catalogo
Bien *-- "0..1" Subcategoria
Bien ..> ClaveDeSegmentacion : <<crea>>
Bien ..> TipoBien

' ─────────────── ENTIDADES BENEFICIARIAS ───────────────

EntidadBeneficiaria *-- "0..1" Direccion
EntidadBeneficiaria *-- "0..*" MedioDeContacto
EntidadBeneficiaria *-- "0..*" Representante
EntidadBeneficiaria *-- "0..*" Campania
Campania *-- "0..*" Necesidad
Necesidad *-- "0..1" Subcategoria
Necesidad ..> TipoNecesidad
NecesidadRecurrente --> "0..1" Periodicidad
Direccion *-- "0..1" Localidad
Localidad *-- "0..1" Provincia

' ─────────────── ASIGNACIÓN ───────────────

' Composición: @ElementCollection de objetos @Embeddable (una sola tabla ranking_puesto).
' Las referencias por id (idDonacion, idEntidad) no son asociaciones de objetos.

RankingPrecalculado *-- "0..*\n{ordered}" PuestoRanking
PuestoRanking *-- "1" ResultadoAsignacion
RankingPrecalculado ..> ResultadoMatchmaking : <<crea>>
ResultadoMatchmaking --> "0..*" ResultadoAsignacion
RecepcionDiariaEntidad *-- "1" ClaveRecepcion

@enduml
